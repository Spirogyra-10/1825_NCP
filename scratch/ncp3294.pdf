         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NCP3294 - 25 A Stackable Synchronous Buck Regulator</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The NCP3294 is a highly efficient stackable synchronous buck&#xD;&#xA;regulator, capable of operating with an input range from 3 V to 18 V&#xD;&#xA;and supporting up to 25 A continuous load currents.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:4d8d15d7-44fc-4693-a439-bef1799b7cd4</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:d06ebc6a-fc98-4da1-979f-cd82ccb556fb</xmpMM:InstanceID>
      </rdf:Description>
